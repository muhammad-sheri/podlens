# Copy to backend/.env and adjust as needed. Do NOT commit real secrets.

# --- Django ---
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Postgres (relational app data: podcasts, episodes) ---
POSTGRES_DB=podlens
POSTGRES_USER=podlens
POSTGRES_PASSWORD=podlens
POSTGRES_HOST=localhost
POSTGRES_PORT=5433   # matches the host port published in docker-compose.yml

# --- ClickHouse (analytics events) ---
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8124   # matches the host port published in docker-compose.yml
CLICKHOUSE_DB=podlens
CLICKHOUSE_USER=podlens
CLICKHOUSE_PASSWORD=podlens

# --- CORS / frontend ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Claude AI insights (optional) ---
# Leave unset to run with a canned, clearly-labeled stub insight (no key needed).
# Set a real key to enable live Claude-generated insights.
# ANTHROPIC_API_KEY=sk-ant-...
